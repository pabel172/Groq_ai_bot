# Telegram
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Groq
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile

# Admin
ADMIN_ID=YOUR_TELEGRAM_USER_ID

# Database
DATABASE=bot.db

# AI settings
SYSTEM_PROMPT=You are a helpful, friendly and intelligent AI assistant. Answer clearly and accurately. Keep responses reasonably concise unless the user asks for detail.
MAX_HISTORY=12
MAX_USER_MESSAGE_LENGTH=12000
MAX_OUTPUT_TOKENS=2048
TEMPERATURE=0.7

# Rate limiting
RATE_LIMIT_MESSAGES=10
RATE_LIMIT_WINDOW=60
